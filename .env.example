# 프론트엔드 환경 변수
#
# ⚠️ 이 파일을 복사해서 .env.local 로 쓰세요
#     cp .env.example .env.local
# .env.local 은 gitignore 대상입니다.
#
# ⚠️ NEXT_PUBLIC_ 접두사를 쓰지 마세요.
#    접두사가 붙으면 값이 클라이언트 번들에 박혀 버립니다.
#    이 값은 서버 컴포넌트와 next.config.mjs 의 rewrite 만 씁니다.
BACKEND_BASE_URL=http://localhost:5010/api/v1

# ── 배포 시 (선택) ────────────────────────────────────────
# OG 이미지 절대 URL 이 필요할 때만. 안 넣으면 localhost 로 생긴다.
# NEXT_PUBLIC_SITE_URL=https://<your-domain>
#
# ── 배포용 이미지 빌드 시 ────────────────────────────────
# Docker 이미지 안에서 build 할 때 NEXT_PUBLIC_* 값이 하드코딩되므로
# 빌드 시점에 넘겨야 한다.
#   docker build --build-arg NEXT_PUBLIC_SITE_URL=https://xxx.run.app ...